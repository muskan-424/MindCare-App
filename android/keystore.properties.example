# Copy to keystore.properties and fill in after generating a release keystore.
# Generate: keytool -genkeypair -v -storetype PKCS12 -keystore release.keystore -alias mindcare -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.keystore
storePassword=your_store_password
keyAlias=mindcare
keyPassword=your_key_password
