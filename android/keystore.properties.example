# Copy to android/keystore.properties and fill in after generating a release keystore.
# storeFile is relative to android/app/ (same folder as this app's build.gradle).
#
# From project root:
#   keytool -genkeypair -v -storetype PKCS12 -keystore android/app/release.keystore -alias mindcare -keyalg RSA -keysize 2048 -validity 10000
#
# Never commit keystore.properties or release.keystore (both are gitignored).
storeFile=release.keystore
storePassword=your_store_password
keyAlias=mindcare
keyPassword=your_key_password
