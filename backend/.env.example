# MindCare API — copy to .env for local dev; set the same keys in Vercel/Render project settings.
NODE_ENV=development
PORT=5000

# Required in production
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/mindcare
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_TOKEN=replace_with_admin_dashboard_token

# Optional
REDIS_URL=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=

# Python ML server (ml/server.py). Defaults to localhost for local dev;
# set to the deployed ML service's public URL in production.
ML_SERVER_URL=http://127.0.0.1:8000

# Email (Gmail SMTP) — used to send login verification codes.
# SMTP_USER is your Gmail address; SMTP_PASS is a Gmail "App Password"
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
